# Database Configuration
DATABASE_URL="postgres://username:password@host:port/database?sslmode=require"

# Individual DB Connection Parameters (for migration scripts)
DB_HOST=your-database-host.com
DB_PORT=5432
DB_USER=your-db-username
DB_PASSWORD=your-db-password
DB_NAME=your-database-name

# Database Pool Settings
PS_VAR_DB_POOL_SIZE=10
PS_VAR_DB_MAX_OVERFLOW=20
PS_VAR_DB_POOL_TIMEOUT=30

# Prisma Connection Pool Settings (Recommended for Production)
# Increase this value based on your concurrent request load
# Default: 200, Recommended range: 100-500 depending on RDS instance size
DB_CONNECTION_LIMIT=200

# Server Configuration
NODE_ENV=development
PORT=3000

# Keycloak Authentication Configuration
KEYCLOAK_BASE_URL=https://your-keycloak-server.com
KEYCLOAK_REALM=your-realm-name
KEYCLOAK_QUANTUM_CLIENT_ID=your-client-id
KEYCLOAK_QUANTUM_CLIENT_SECRET=your-client-secret
KEYCLOAK_ADMIN_USERNAME=admin@example.com
KEYCLOAK_ADMIN_PASSWORD=your-admin-password

# JWT Configuration - DEPRECATED (Removed in favor of Keycloak)
# JWT_SECRET is no longer used. Authentication is now handled by Keycloak.
# JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-use-long-random-string
# JWT_EXPIRES_IN=7d

# API Configuration
API_VERSION=v1
# CORS Configuration - Comma-separated list of allowed origins
# Production example: CORS_ORIGIN=https://app.yourdomain.com,https://admin.yourdomain.com
# Development example: CORS_ORIGIN=http://localhost:5173,http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Keycloak Backend Client Credentials
grant_type=client_credentials
client_id=your-backend-client-id
client_secret=your-backend-client-secret

# SMTP Configuration (Required for Email Notifications)
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_FROM=your-email@example.com

# Temporal Configuration (Required for Workflow Orchestration)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TLS=false

# Dunning Scheduler Configuration (Optional - for automatic workflow triggering)
# Set to 'true' to enable automatic dunning for overdue invoices
ENABLE_DUNNING_SCHEDULER=false
# How often to check for overdue invoices (in minutes)
DUNNING_SCHEDULER_INTERVAL=60

# External Events Service Configuration (Required for User Events Metrics)
# Base URL of the external events service
EXTERNAL_EVENTS_BASE_URL=https://3qw7hp8r-8080.inc1.devtunnels.ms/v1
# Organization ID used in external events API calls
EXTERNAL_EVENTS_ORG_ID=org_acme
# Customer ID used in external events API calls
EXTERNAL_EVENTS_CUSTOMER_ID=org_acme

# ═══════════════════════════════════════════════════════
# Billing Service Integration (Lago)
# ═══════════════════════════════════════════════════════
# Enable/disable billing integration (set to 'false' to disable)
BILLING_INTEGRATION_ENABLED=true

# Billing service URL (internal HTTP endpoint)
BILLING_SERVICE_URL=http://billing-service:4000

# Internal API key for billing service authentication (must match INTERNAL_API_KEY in billing service .env)
BILLING_SERVICE_API_KEY=your-shared-internal-api-key-change-in-production

# Billing level: 'org' (default, one billing account per organization) or 'customer' (one billing account per customer)
# B2B SaaS: use 'org' | Marketplace/Reseller: use 'customer'
BILLING_LEVEL=org

# Lago webhook secret (for incoming webhooks from Lago via billing service)
LAGO_WEBHOOK_SECRET=your-lago-webhook-secret
