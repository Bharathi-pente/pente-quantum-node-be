# Database Configuration
DATABASE_URL="postgres://username:password@host:port/database?sslmode=require"

# Database Pool Settings
PS_VAR_DB_POOL_SIZE=10
PS_VAR_DB_MAX_OVERFLOW=20
PS_VAR_DB_POOL_TIMEOUT=30

# Server Configuration
NODE_ENV=development
PORT=3000

# Keycloak Configuration (Required for Authentication)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=quantum-billing

# JWT Configuration - DEPRECATED (Removed in favor of Keycloak)
# JWT_SECRET is no longer used. Authentication is now handled by Keycloak.
# JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-use-long-random-string
# JWT_EXPIRES_IN=7d

# API Configuration
API_VERSION=v1
# CORS Configuration - Comma-separated list of allowed origins
# Production example: CORS_ORIGIN=https://app.yourdomain.com,https://admin.yourdomain.com
# Development example: CORS_ORIGIN=http://localhost:5173,http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100


grant_type=client_credentials
client_id=quantum-backend
client_secret=qlEOGiWL4jdO9UbU7BxJhQ7KpVuAzZLD
