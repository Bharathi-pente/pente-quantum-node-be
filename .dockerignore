# ═══════════════════════════════════════════════════════════
# Docker Ignore File
# ═══════════════════════════════════════════════════════════
# Prevents unnecessary files from being copied into Docker image
# Reduces build time and image size
#
# ═══════════════════════════════════════════════════════════

# Node modules (will be installed in container)
node_modules/
npm-debug.log
yarn-error.log
# package-lock.json is needed for npm ci

# Build output (will be built in container)
dist/
build/

# Git
.git/
.gitignore
.gitattributes

# IDE and Editor
.vscode/
.idea/
*.swp
*.swo
*.swn
*.sublime-*
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Environment files (use Docker secrets instead)
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production

# Testing
coverage/
.nyc_output/
*.test.ts
*.spec.ts
__tests__/
__mocks__/

# Documentation (optional - keep if you want docs in image)
*.md
docs/
CUSTOMER_API_DOCS.md
PROJECT_OVERVIEW.md
QUICK_REFERENCE.md
README.md
SETUP_GUIDE.md
SUMMARY.md
CURSOR_PAGINATION_GUIDE.md
REPOSITORY_PATTERN_GUIDE.md
CONTROLLER_REFACTORING_GUIDE.md

# Docker files (no need to copy these into the image)
Dockerfile
Dockerfile.*
docker-compose*.yml
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
.circleci/
azure-pipelines.yml

# Temporary files
tmp/
temp/
*.tmp

# Database files (if any local DB files)
*.sqlite
*.sqlite3
*.db

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Misc
*.orig
*.bak
*.backup
*~
