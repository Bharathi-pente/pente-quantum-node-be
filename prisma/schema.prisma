/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model alert_history {
  id              String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  alert_id        String          @db.Uuid
  channel_id      String?         @db.Uuid
  triggered_at    DateTime        @default(now()) @db.Timestamp(6)
  customer_id     String?         @db.Uuid
  value_snapshot  String?         @db.VarChar(255)
  delivery_status String?         @db.VarChar(50)
  alerts          alerts          @relation(fields: [alert_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  alert_channels  alert_channels? @relation(fields: [channel_id], references: [id], onUpdate: NoAction)
  customers       customers?      @relation(fields: [customer_id], references: [id], onUpdate: NoAction)

  @@index([alert_id], map: "idx_alert_history_alert_id")
  @@index([channel_id], map: "idx_alert_history_channel_id")
  @@index([customer_id], map: "idx_alert_history_customer_id")
