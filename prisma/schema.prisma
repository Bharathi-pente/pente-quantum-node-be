generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model alert_channel_map {
  id             String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  alert_id       String         @db.Uuid
  channel_id     String         @db.Uuid
  alerts         alerts         @relation(fields: [alert_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  alert_channels alert_channels @relation(fields: [channel_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([alert_id, channel_id])
  @@index([alert_id], map: "idx_alert_channel_map_alert_id")
  @@index([channel_id], map: "idx_alert_channel_map_channel_id")
}

